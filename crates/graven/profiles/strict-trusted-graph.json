  "author": "WIST Protocol",
  "license": "CC0-1.0",
  "issues_url": "https://github.com/wistprotocol/graven/issues",
  "superseded_by": null,
  "labelers": [],
  "agreement_k": 1,
  "seeds": [],
  "distrust_seeds": [],
  "weights": {
    "trust_floor": 0.0,
    "trust": 1.0,
    "inlinks": 0.0,
    "freshness": 0.1,
    "distrust": 1.0,
    "mismatch": 0.5
  },
  "filters": {
    "distrust_above": 0.25,
    "spam": true,
    "min_age_blocks": 0,
    "trusted_graph_only": true
